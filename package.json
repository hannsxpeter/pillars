    "markdown",
    "open-standard",
    "pillars"
  ],
  "homepage": "https://github.com/hannsxpeter/pillars#readme",
  "bugs": {
    "url": "https://github.com/hannsxpeter/pillars/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hannsxpeter/pillars.git"
  },
  "license": "CC0-1.0",
  "author": "hannsxpeter",
  "publishConfig": {
